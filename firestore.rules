rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return activeUser()
        && 'dns-admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.globalRoles;
    }

    function hasGrant(scopeType, scopeId, permission) {
      let grantId = request.auth.uid + "__" + scopeType + "__" + scopeId;
      let grantPath = /databases/$(database)/documents/accessGrants/$(grantId);
      return activeUser()
        && scopeId != ''
        && exists(grantPath)
        && get(grantPath).data.active == true
        && permission in get(grantPath).data.permissions;
    }

    function dataAreaId(data) {
      return data.keys().hasAny(['reportingAreaId'])
        ? data.reportingAreaId
        : '';
    }

    function validFlyerScope(data) {
      return data.scopeType in ['network', 'reportingArea', 'organization']
        && data.scopeId is string
        && data.scopeId.size() > 0
        && (data.scopeType != 'network' || data.scopeId == 'dolomiti-nordicski')
        && (data.scopeType != 'reportingArea'
            || exists(/databases/$(database)/documents/reportingAreas/$(data.scopeId)))
        && (data.scopeType != 'organization'
            || exists(/databases/$(database)/documents/organizations/$(data.scopeId)));
    }

    function hasFlyerPermission(permission, data) {
      return isAdmin()
        || hasGrant('network', 'dolomiti-nordicski', permission)
        || (data.scopeType == 'reportingArea'
            && hasGrant('reportingArea', data.scopeId, permission))
        || (data.scopeType == 'organization'
            && hasGrant('organization', data.scopeId, permission));
    }

    function validFlyerDocument(data) {
      return validFlyerScope(data)
        && data.schema == 'dns.flyer-document'
        && data.version == 1
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.status in ['draft', 'ready', 'archived']
        && data.document is map
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validFlyerPublication(data) {
      return validFlyerScope(data)
        && data.schema == 'dns.flyer-publication'
        && data.version == 1
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.flyerDocumentId is string
        && data.flyerDocumentId.size() > 0
        && data.snapshot is map
        && data.publishedBy == request.auth.uid
        && data.publishedAt == request.time;
    }

    function validFlyerTemplate(data) {
      return validFlyerScope(data)
        && data.schema == 'dns.flyer-template'
        && data.version == 1
        && data.name is string
        && data.name.size() > 0
        && data.blockStack is list
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validFlyerAsset(data) {
      return validFlyerScope(data)
        && data.schema == 'dns.flyer-asset'
        && data.version == 1
        && data.assetType in ['image', 'logo', 'icon', 'document']
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function hasOrderPermission(permission, data) {
      return isAdmin()
        || hasGrant('network', 'dolomiti-nordicski', permission)
        || hasGrant('organization', data.organizationId, permission)
        || hasGrant('reportingArea', dataAreaId(data), permission);
    }

    function historicalLocked(data) {
      return data.seasonId in ['2024-25', '2025-26'];
    }

    function validOrder(data) {
      return !historicalLocked(data) && data.seasonId is string
        && data.organizationId is string
        && data.category in ['ticket', 'wristband', 'pocketfolder']
        && data.status in ['draft', 'submitted', 'confirmed', 'fulfilled', 'cancelled'];
    }

    function validOrderLine(data) {
      return !historicalLocked(data) && data.seasonId is string
        && data.organizationId is string
        && data.ticketOrderId is string
        && data.catalogItemId is string
        && data.quantity is int
        && data.quantity >= 0;
    }

    function lineMatchesOrder(data) {
      let orderPath = /databases/$(database)/documents/ticketOrders/$(data.ticketOrderId);
      let order = getAfter(orderPath);
      return order.data.organizationId == data.organizationId
        && order.data.seasonId == data.seasonId;
    }

    function canVerifyOrder(data) {
      return isAdmin() || hasOrderPermission('ticketOrders.verify', data);
    }

    function contributorOrderTransitionAllowed(before, after) {
      return before.status == 'draft'
        && after.status in ['draft', 'submitted'];
    }

    function parentOrderEditableForLine(data) {
      let orderPath = /databases/$(database)/documents/ticketOrders/$(data.ticketOrderId);
      let order = getAfter(orderPath).data;
      return order.status == 'draft' || canVerifyOrder(order);
    }

    function billingSnapshotTypeAllowed(data) {
      return !data.keys().hasAny(['snapshotType'])
        || data.snapshotType in ['orders', 'unified'];
    }

    function billingReadyAllowed(data) {
      return data.status != 'ready'
        || (
          data.unpricedQuantity == 0
          && (
            !data.keys().hasAny(['snapshotType'])
            || data.snapshotType != 'unified'
            || (
              data.sourceState == 'complete'
              && data.sourceBlockingReasons is list
              && data.sourceBlockingReasons.size() == 0
              && 'fair-membership' in data.sourceTypes
              && 'idm-premium-partner' in data.sourceTypes
              && 'order' in data.sourceTypes
              && 'seasonal-extra' in data.sourceTypes
            )
          )
        );
    }

    function validBillingLineSource(data) {
      return data.source is map
        && data.source.type in ['fair-membership', 'idm-premium-partner', 'order', 'seasonal-extra']
        && data.source.sourceId is string
        && data.source.sourceId.size() > 0
        && data.source.sourceLabel is string
        && data.source.sourceLabel.size() > 0
        && (
          (
            data.source.type == 'order'
            && data.catalogItemId is string
            && data.rateId is string
            && data.rateRevision is int
            && data.rateRevision >= 1
            && data.sourceDocumentLabel is string
            && data.sourceDocumentLabel.size() > 0
          )
          || (
            data.source.type == 'fair-membership'
          )
          || (
            data.source.type == 'idm-premium-partner'
            && data.source.sourceRevision is int
            && data.source.sourceRevision >= 1
          )
          || (
            data.source.type == 'seasonal-extra'
            && data.source.sourceRevision is int
            && data.source.sourceRevision >= 1
            && data.sourceDocumentLabel is string
            && data.sourceDocumentLabel.size() > 0
          )
        );
    }

    // Public canonical master data.
    match /reportingAreas/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /destinations/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /organizations/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /organizationRelationships/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /seasons/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /designSystem/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Shared season-scoped allocation keys. These are canonical reference data
    // consumed by FAIR, Faktura and future DNS tools.
    match /areaAllocationKeys/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Immutable/read-only Analytics audit copies used only for zero-loss parity checks.
    match /analyticsAuditSnapshots/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Published aggregate Analytics read model. Exact-document reads only:
    // no collection listing, no client writes, no raw operational rows.
    match /analyticsPublicSnapshots/{seasonId} {
      allow get: if resource.data.id == seasonId
                 && resource.data.seasonId == seasonId
                 && resource.data.publicationStatus == 'published';
      allow list, write: if false;
    }

    // Private authorization metadata.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /memberships/{document} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /accessGrants/{document} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Seasonal order catalogue/configuration is available to active DNS users.
    // Only DNS administrators can alter the catalogue itself.
    match /orderCatalogItems/{document} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /orderFormConfigs/{document} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /deliveryLocations/{document} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /pocketfolderSetupImports/{document} {
      allow read, write: if false;
    }

    match /pocketfolderSourceRows/{document} {
      allow read: if activeUser();
      allow write: if false;
    }

    // Operational order headers.
    match /ticketOrders/{document} {
      allow read: if hasOrderPermission('ticketOrders.read', resource.data);

      allow create: if validOrder(request.resource.data)
        && hasOrderPermission('ticketOrders.write', request.resource.data);

      allow update: if validOrder(request.resource.data)
        && resource.data.organizationId == request.resource.data.organizationId
        && resource.data.seasonId == request.resource.data.seasonId
        && resource.data.category == request.resource.data.category
        && (
          canVerifyOrder(request.resource.data)
          || (
            hasOrderPermission('ticketOrders.write', request.resource.data)
            && contributorOrderTransitionAllowed(resource.data, request.resource.data)
          )
        );

      // Order headers are retained for audit; normal contributors do not delete them.
      allow delete: if isAdmin() && !historicalLocked(resource.data);
    }

    // Operational order matrix cells.
    match /ticketOrderLines/{document} {
      allow read: if hasOrderPermission('ticketOrders.read', resource.data);

      allow create: if validOrderLine(request.resource.data)
        && (hasOrderPermission('ticketOrders.write', request.resource.data) || canVerifyOrder(request.resource.data))
        && lineMatchesOrder(request.resource.data)
        && parentOrderEditableForLine(request.resource.data);

      allow update: if validOrderLine(request.resource.data)
        && resource.data.organizationId == request.resource.data.organizationId
        && resource.data.seasonId == request.resource.data.seasonId
        && resource.data.ticketOrderId == request.resource.data.ticketOrderId
        && resource.data.catalogItemId == request.resource.data.catalogItemId
        && (hasOrderPermission('ticketOrders.write', request.resource.data) || canVerifyOrder(request.resource.data))
        && lineMatchesOrder(request.resource.data)
        && parentOrderEditableForLine(request.resource.data);

      // Clearing a matrix cell deletes only that organization's own line.
      allow delete: if !historicalLocked(resource.data)
        && (hasOrderPermission('ticketOrders.write', resource.data) || canVerifyOrder(resource.data))
        && parentOrderEditableForLine(resource.data);
    }

    // Public supplier snapshots. Public clients can fetch one exact document
    // by its unguessable ID, but cannot list/search the collection.
    match /publicOrderShares/{shareId} {
      allow get: if resource.data.active == true
                 && (!resource.data.keys().hasAny(['expiresAt'])
                     || request.time < resource.data.expiresAt);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // One-time import markers are trusted-backend only.
    match /orderSetupImports/{document} {
      allow read, write: if false;
    }

    function validPricing(data) {
      return data.keys().hasOnly(['id','seasonId','scopeType','scopeId','productCode','salesChannel','salesPeriod','unitPrice','settlementUnitPrice','currency','active','validFrom','validTo','notes','revision','provenance','updatedBy','updatedAt'])
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.scopeType in ['network','reportingArea','organization']
        && (data.scopeType != 'network' || data.scopeId == 'dolomiti-nordicski')
        && (data.scopeType != 'reportingArea' || exists(/databases/$(database)/documents/reportingAreas/$(data.scopeId)))
        && (data.scopeType != 'organization' || exists(/databases/$(database)/documents/organizations/$(data.scopeId)))
        && data.productCode in ['day','wk-area','wk-dns','sk-area','sk-dns','sk-instructor']
        && data.salesChannel in ['official','online','track','press','complimentary']
        && data.salesPeriod in ['regular','presale']
        && data.unitPrice is number && data.unitPrice >= 0
        && data.settlementUnitPrice is number && data.settlementUnitPrice >= 0
        && data.currency == 'EUR' && data.active == true
        && data.revision is int && data.revision >= 1
        && data.provenance.sourceSystem == 'manual-data-entry'
        && data.provenance.methodVersion == 1 && data.provenance.dataStatus == 'draft'
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    function managePricing(data) {
      return isAdmin() || hasGrant('network','dolomiti-nordicski','pricing.manage')
        || hasGrant(data.scopeType,data.scopeId,'pricing.manage');
    }

    function validSales(data) {
      return data.keys().hasOnly(['id','draftKey','seasonId','organizationId','reportingAreaId','productCode','salesChannel','salesPeriod','quantity','amountOverride','amountOverrideReason','pricing','calculatedAmount','revision','provenance','updatedBy','updatedAt'])
        && data.id == data.seasonId + '__' + data.organizationId + '__' + data.reportingAreaId + '__' + data.productCode + '__' + data.salesChannel + '__' + data.salesPeriod
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.reportingAreaId in get(/databases/$(database)/documents/organizations/$(data.organizationId)).data.reportingAreaIds
        && data.quantity is int && data.quantity >= 0 && data.quantity <= 9007199254740991
        && data.productCode in ['day','wk-area','wk-dns','sk-area','sk-dns','sk-instructor']
        && data.salesChannel in ['official','online','track','press','complimentary']
        && data.salesPeriod in ['regular','presale']
        && data.pricing.currency == 'EUR'
        && data.pricing.unitPrice is number && data.pricing.unitPrice >= 0
        && data.pricing.settlementUnitPrice is number && data.pricing.settlementUnitPrice >= 0
        && data.calculatedAmount is number && data.calculatedAmount >= 0
        && data.calculatedAmount - data.quantity * data.pricing.unitPrice < 0.011
        && data.quantity * data.pricing.unitPrice - data.calculatedAmount < 0.011
        && (data.amountOverride == null || (data.amountOverride is number && data.amountOverride >= 0 && data.amountOverrideReason is string && data.amountOverrideReason.size() > 0))
        && data.revision is int && data.revision >= 1
        && data.provenance.sourceSystem == 'manual-data-entry'
        && data.provenance.methodVersion == 1 && data.provenance.dataStatus == 'draft'
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    function salesPricingMatches(data) {
      let config = get(/databases/$(database)/documents/ticketPricingConfigs/$(data.pricing.pricingConfigId)).data;
      return config.active == true && config.seasonId == data.seasonId
        && config.productCode == data.productCode && config.salesChannel == data.salesChannel && config.salesPeriod == data.salesPeriod
        && config.unitPrice == data.pricing.unitPrice && config.settlementUnitPrice == data.pricing.settlementUnitPrice
        && ((config.scopeType == 'network' && config.scopeId == 'dolomiti-nordicski')
          || (config.scopeType == 'reportingArea' && config.scopeId == data.reportingAreaId)
          || (config.scopeType == 'organization' && config.scopeId == data.organizationId));
    }

    function archived(collectionName, document) {
      let revisionId = string(resource.data.revision);
      return getAfter(/databases/$(database)/documents/$(collectionName)/$(document)/revisions/$(revisionId)).data == resource.data;
    }

    match /ticketPricingConfigs/{document} {
      allow read: if activeUser();
      allow create: if !historicalLocked(request.resource.data) && validPricing(request.resource.data) && managePricing(request.resource.data)
        && request.resource.data.id == document && request.resource.data.revision == 1;
      allow update: if !historicalLocked(request.resource.data) && validPricing(request.resource.data) && managePricing(resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.scopeType == resource.data.scopeType && request.resource.data.scopeId == resource.data.scopeId
        && request.resource.data.productCode == resource.data.productCode
        && request.resource.data.salesChannel == resource.data.salesChannel && request.resource.data.salesPeriod == resource.data.salesPeriod
        && resource.data.provenance.dataStatus == 'draft'
        && request.resource.data.revision == resource.data.revision + 1 && archived('ticketPricingConfigs',document);
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if activeUser();
        allow create: if managePricing(get(/databases/$(database)/documents/ticketPricingConfigs/$(document)).data)
          && request.resource.data == get(/databases/$(database)/documents/ticketPricingConfigs/$(document)).data
          && getAfter(/databases/$(database)/documents/ticketPricingConfigs/$(document)).data.revision == request.resource.data.revision + 1;
        allow update, delete: if false;
      }
    }

    function canReadNewSalesDocument(document) {
      let parts = document.split('__');
      return isAdmin() || (parts.size() == 6 && (
        hasGrant('network','dolomiti-nordicski','ticketSales.read')
        || hasGrant('organization',parts[1],'ticketSales.read')
        || hasGrant('reportingArea',parts[2],'ticketSales.read')));
    }

    // DNS Faktura commercial rates. Rates are internal DNS Commercial
    // configuration and always require a human-readable source document label.
    match /billingRateConfigs/{document} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.seasonId is string
        && request.resource.data.sourceType == 'order'
        && request.resource.data.catalogItemId is string
        && request.resource.data.billingUnitPrice is number
        && request.resource.data.billingUnitPrice >= 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.source is map
        && request.resource.data.source.documentLabel is string
        && request.resource.data.source.documentLabel.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.revision == 1;

      allow update: if isAdmin()
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.catalogItemId == resource.data.catalogItemId
        && request.resource.data.billingUnitPrice is number
        && request.resource.data.billingUnitPrice >= 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.source is map
        && request.resource.data.source.documentLabel is string
        && request.resource.data.source.documentLabel.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if false;
    }

    // DNS Faktura seasonal extras. These are sourced, admin-managed
    // commercial items such as seasonal clothing or one-off supplies.
    match /billingSeasonalExtras/{document} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.id == document
        && request.resource.data.seasonId is string
        && request.resource.data.sourceType == 'seasonal-extra'
        && request.resource.data.organizationId is string
        && request.resource.data.reportingAreaId is string
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.unitAmount is number
        && request.resource.data.unitAmount >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.source is map
        && request.resource.data.source.documentLabel is string
        && request.resource.data.source.documentLabel.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.revision == 1;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.reportingAreaId == resource.data.reportingAreaId
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.unitAmount is number
        && request.resource.data.unitAmount >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.source is map
        && request.resource.data.source.documentLabel is string
        && request.resource.data.source.documentLabel.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if false;
    }

    // DNS Faktura billing snapshots. A run may be revised while draft.
    // READY snapshots are immutable; line snapshots are append-only.
    match /billingRuns/{document} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.id == document
        && request.resource.data.seasonId is string
        && request.resource.data.organizationId is string
        && request.resource.data.reportingAreaId is string
        && (request.resource.data.status == 'draft' || request.resource.data.status == 'ready')
        && request.resource.data.revision == 1
        && billingSnapshotTypeAllowed(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['snapshotType'])
          || request.resource.data.snapshotType != 'unified'
          || (
            request.resource.data.sourceState in ['complete', 'incomplete']
            && request.resource.data.sourceBlockingReasons is list
          )
        )
        && request.resource.data.sourceTypes is list
        && request.resource.data.sourceOrderStatuses is list
        && request.resource.data.lineCount is int
        && request.resource.data.lineCount >= 0
        && request.resource.data.billedQuantity is number
        && request.resource.data.billedQuantity >= 0
        && request.resource.data.unpricedQuantity is number
        && request.resource.data.unpricedQuantity >= 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.generatedBy is string
        && request.resource.data.generatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && billingReadyAllowed(request.resource.data);

      allow update: if isAdmin()
        && resource.data.status == 'draft'
        && request.resource.data.id == resource.data.id
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.reportingAreaId == resource.data.reportingAreaId
        && (request.resource.data.status == 'draft' || request.resource.data.status == 'ready')
        && request.resource.data.revision == resource.data.revision + 1
        && billingSnapshotTypeAllowed(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['snapshotType'])
          || request.resource.data.snapshotType != 'unified'
          || (
            request.resource.data.sourceState in ['complete', 'incomplete']
            && request.resource.data.sourceBlockingReasons is list
          )
        )
        && request.resource.data.sourceTypes is list
        && request.resource.data.sourceOrderStatuses is list
        && request.resource.data.lineCount is int
        && request.resource.data.lineCount >= 0
        && request.resource.data.billedQuantity is number
        && request.resource.data.billedQuantity >= 0
        && request.resource.data.unpricedQuantity is number
        && request.resource.data.unpricedQuantity >= 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.generatedBy is string
        && request.resource.data.generatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && billingReadyAllowed(request.resource.data);

      allow delete: if false;
    }

    match /billingLines/{document} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.id == document
        && request.resource.data.runId is string
        && request.resource.data.runRevision is int
        && request.resource.data.runRevision >= 1
        && request.resource.data.seasonId is string
        && request.resource.data.organizationId is string
        && request.resource.data.reportingAreaId is string
        && validBillingLineSource(request.resource.data)
        && request.resource.data.description is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.unitAmount is number
        && request.resource.data.unitAmount >= 0
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.included is bool
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/billingRuns/$(request.resource.data.runId)).data.revision == request.resource.data.runRevision
        && getAfter(/databases/$(database)/documents/billingRuns/$(request.resource.data.runId)).data.seasonId == request.resource.data.seasonId
        && getAfter(/databases/$(database)/documents/billingRuns/$(request.resource.data.runId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/billingRuns/$(request.resource.data.runId)).data.reportingAreaId == request.resource.data.reportingAreaId
        && getAfter(/databases/$(database)/documents/billingRuns/$(request.resource.data.runId)).data.updatedAt == request.time;

      allow update, delete: if false;
    }

    match /ticketSales/{document} {
      allow get: if (resource == null && canReadNewSalesDocument(document))
        || (resource != null && hasOrderPermission('ticketSales.read',resource.data));
      allow list: if hasOrderPermission('ticketSales.read',resource.data);
      allow create: if !historicalLocked(request.resource.data) && validSales(request.resource.data) && salesPricingMatches(request.resource.data)
        && hasOrderPermission('ticketSales.write',request.resource.data)
        && request.resource.data.id == document && request.resource.data.revision == 1;
      allow update: if !historicalLocked(request.resource.data) && validSales(request.resource.data) && salesPricingMatches(request.resource.data)
        && hasOrderPermission('ticketSales.write',resource.data)
        && request.resource.data.id == resource.data.id && request.resource.data.draftKey == resource.data.draftKey
        && request.resource.data.organizationId == resource.data.organizationId && request.resource.data.reportingAreaId == resource.data.reportingAreaId
        && request.resource.data.seasonId == resource.data.seasonId && request.resource.data.productCode == resource.data.productCode
        && request.resource.data.salesChannel == resource.data.salesChannel && request.resource.data.salesPeriod == resource.data.salesPeriod
        && resource.data.provenance.dataStatus == 'draft'
        && request.resource.data.revision == resource.data.revision + 1 && archived('ticketSales',document);
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if hasOrderPermission('ticketSales.read',get(/databases/$(database)/documents/ticketSales/$(document)).data);
        allow create: if hasOrderPermission('ticketSales.write',get(/databases/$(database)/documents/ticketSales/$(document)).data)
          && request.resource.data == get(/databases/$(database)/documents/ticketSales/$(document)).data
          && getAfter(/databases/$(database)/documents/ticketSales/$(document)).data.revision == request.resource.data.revision + 1;
        allow update, delete: if false;
      }
    }

    function manageKpMilestones() {
      return isAdmin() || hasGrant('network','dolomiti-nordicski','kp.write');
    }

    function hasKpPermission(permission, data) {
      return isAdmin()
        || (data.entityType == 'organization' && hasGrant('organization',data.entityId,permission))
        || hasGrant('reportingArea',data.reportingAreaId,permission)
        || hasGrant('network','dolomiti-nordicski',permission);
    }

    function validKpMilestone(data) {
      return data.keys().hasOnly(['id','seasonId','date','label','order','updatedBy','updatedAt'])
        && !historicalLocked(data)
        && data.id is string
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.date is string && data.date.size() == 10
        && data.label is string
        && data.order is int && data.order >= 1 && data.order <= 3
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validKpMilestoneValue(value, seasonId) {
      let snowTotal = value.naturalSnowKm + value.artificialSnowKm;
      return value.keys().hasOnly(['milestoneId','openedKm','naturalSnowKm','artificialSnowKm'])
        && value.milestoneId is string
        && get(/databases/$(database)/documents/kpMilestones/$(value.milestoneId)).data.seasonId == seasonId
        && value.openedKm is number && value.openedKm >= 0
        && value.naturalSnowKm is number && value.naturalSnowKm >= 0
        && value.artificialSnowKm is number && value.artificialSnowKm >= 0
        && value.artificialSnowKm <= value.openedKm
        && snowTotal - value.openedKm < 0.011
        && value.openedKm - snowTotal < 0.011;
    }

    function validKpEntry(data) {
      return data.keys().hasOnly(['id','seasonId','entityType','entityId','reportingAreaId','referenceKm','milestones','includeInKp','exclusionReason','provenance','notes','revision','updatedBy','updatedAt'])
        && !historicalLocked(data)
        && data.id == data.seasonId + '__' + data.entityId
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.entityType == 'organization'
        && data.entityId is string
        && exists(/databases/$(database)/documents/organizations/$(data.entityId))
        && data.reportingAreaId in get(/databases/$(database)/documents/organizations/$(data.entityId)).data.reportingAreaIds
        && data.referenceKm.keys().hasOnly(['uniqueNetworkKm','potentialOperationalKm'])
        && data.referenceKm.uniqueNetworkKm is number && data.referenceKm.uniqueNetworkKm >= 0
        && data.referenceKm.potentialOperationalKm is number && data.referenceKm.potentialOperationalKm >= 0
        && data.milestones is list && data.milestones.size() <= 3
        && (data.milestones.size() < 1 || validKpMilestoneValue(data.milestones[0],data.seasonId))
        && (data.milestones.size() < 2 || validKpMilestoneValue(data.milestones[1],data.seasonId))
        && (data.milestones.size() < 3 || validKpMilestoneValue(data.milestones[2],data.seasonId))
        && data.includeInKp is bool
        && data.exclusionReason is string
        && data.provenance.sourceSystem == 'manual-data-entry'
        && data.provenance.methodVersion == 1
        && data.provenance.dataStatus == 'draft'
        && data.notes is string
        && data.revision is int && data.revision >= 1
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /kpMilestones/{document} {
      allow read: if activeUser();
      allow create: if validKpMilestone(request.resource.data)
        && request.resource.data.id == document
        && manageKpMilestones();
      allow update: if validKpMilestone(request.resource.data)
        && resource.data.id == request.resource.data.id
        && resource.data.seasonId == request.resource.data.seasonId
        && manageKpMilestones();
      allow delete: if false;
    }

    function hasKpAreaPermission(permission, data) {
      return isAdmin()
        || hasGrant('reportingArea',data.reportingAreaId,permission)
        || hasGrant('network','dolomiti-nordicski',permission);
    }

    function validKpFairValidation(data) {
      let snowTotal = data.naturalSnowKm + data.artificialSnowKm;
      return data.keys().hasOnly(['id','seasonId','reportingAreaId','milestoneId','potentialOperationalKm','openedKm','naturalSnowKm','artificialSnowKm','revision','validatedBy','validatedAt'])
        && !historicalLocked(data)
        && data.id == data.seasonId + '__' + data.reportingAreaId + '__' + data.milestoneId
        && data.seasonId is string
        && exists(/databases/$(database)/documents/seasons/$(data.seasonId))
        && data.reportingAreaId is string
        && exists(/databases/$(database)/documents/reportingAreas/$(data.reportingAreaId))
        && data.milestoneId is string
        && get(/databases/$(database)/documents/kpMilestones/$(data.milestoneId)).data.seasonId == data.seasonId
        && data.potentialOperationalKm is number && data.potentialOperationalKm >= 0
        && data.openedKm is number && data.openedKm >= 0
        && data.naturalSnowKm is number && data.naturalSnowKm >= 0
        && data.artificialSnowKm is number && data.artificialSnowKm >= 0
        && data.artificialSnowKm <= data.openedKm
        && snowTotal - data.openedKm < 0.011
        && data.openedKm - snowTotal < 0.011
        && data.revision is int && data.revision >= 1
        && data.validatedBy == request.auth.uid
        && data.validatedAt == request.time;
    }

    match /kpFairValidations/{document} {
      allow read: if hasKpAreaPermission('kp.read',resource.data);
      allow create: if validKpFairValidation(request.resource.data)
        && hasKpAreaPermission('kp.verify',request.resource.data)
        && request.resource.data.id == document
        && request.resource.data.revision == 1;
      allow update: if validKpFairValidation(request.resource.data)
        && hasKpAreaPermission('kp.verify',resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.reportingAreaId == resource.data.reportingAreaId
        && request.resource.data.milestoneId == resource.data.milestoneId
        && request.resource.data.revision == resource.data.revision + 1
        && archived('kpFairValidations',document);
      allow delete: if false;

      match /revisions/{revision} {
        allow read: if hasKpAreaPermission('kp.read',get(/databases/$(database)/documents/kpFairValidations/$(document)).data);
        allow create: if hasKpAreaPermission('kp.verify',get(/databases/$(database)/documents/kpFairValidations/$(document)).data)
          && request.resource.data == get(/databases/$(database)/documents/kpFairValidations/$(document)).data
          && getAfter(/databases/$(database)/documents/kpFairValidations/$(document)).data.revision == request.resource.data.revision + 1;
        allow update, delete: if false;
      }
    }

    match /kpEntries/{document} {
      allow read: if hasKpPermission('kp.read',resource.data);
      allow create: if validKpEntry(request.resource.data)
        && hasKpPermission('kp.write',request.resource.data)
        && request.resource.data.id == document
        && request.resource.data.revision == 1;
      allow update: if validKpEntry(request.resource.data)
        && hasKpPermission('kp.write',resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.seasonId == resource.data.seasonId
        && request.resource.data.entityType == resource.data.entityType
        && request.resource.data.entityId == resource.data.entityId
        && request.resource.data.reportingAreaId == resource.data.reportingAreaId
        && resource.data.provenance.dataStatus == 'draft'
        && request.resource.data.revision == resource.data.revision + 1
        && archived('kpEntries',document);
      allow delete: if false;

      match /revisions/{revision} {
        allow read: if hasKpPermission('kp.read',get(/databases/$(database)/documents/kpEntries/$(document)).data);
        allow create: if hasKpPermission('kp.write',get(/databases/$(database)/documents/kpEntries/$(document)).data)
          && request.resource.data == get(/databases/$(database)/documents/kpEntries/$(document)).data
          && getAfter(/databases/$(database)/documents/kpEntries/$(document)).data.revision == request.resource.data.revision + 1;
        allow update, delete: if false;
      }
    }

    match /kpSetupImports/{document} {
      allow read, write: if false;
    }

    // Trusted Admin import only. Historical sources and facts are immutable to all app clients.
    match /historicalSeasonRecords/{document} {
      allow read: if activeUser() && (isAdmin()
        || (resource.data.domain == 'pricing')
        || (resource.data.domain == 'sales' && hasOrderPermission('ticketSales.read',resource.data))
        || (resource.data.domain == 'orders' && hasOrderPermission('ticketOrders.read',resource.data))
        || (resource.data.domain == 'kp' && hasOrderPermission('kp.read',resource.data))
        || (resource.data.domain in ['snow','costs'] && hasOrderPermission('kp.read',resource.data)));
      allow write: if false;
    }
    match /historicalSeasonImports/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /historicalSeasonSources/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // DNS Flyer Studio working documents.
    match /flyerDocuments/{document} {
      allow read: if hasFlyerPermission('flyer.read', resource.data);

      allow create: if activeUser()
        && validFlyerDocument(request.resource.data)
        && request.resource.data.id == document
        && hasFlyerPermission('flyer.write', request.resource.data);

      allow update: if activeUser()
        && validFlyerDocument(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.scopeType == resource.data.scopeType
        && request.resource.data.scopeId == resource.data.scopeId
        && request.resource.data.seasonId == resource.data.seasonId
        && hasFlyerPermission('flyer.write', resource.data);

      allow delete: if isAdmin();
    }

    // Immutable publication snapshots. Published records are append-only.
    match /flyerPublications/{document} {
      allow read: if hasFlyerPermission('flyer.read', resource.data);

      allow create: if activeUser()
        && validFlyerPublication(request.resource.data)
        && request.resource.data.id == document
        && hasFlyerPermission('flyer.publish', request.resource.data);

      allow update, delete: if false;
    }

    // Reusable organization/network Flyer templates.
    match /flyerTemplates/{document} {
      allow read: if hasFlyerPermission('flyer.read', resource.data);

      allow create, update: if activeUser()
        && validFlyerTemplate(request.resource.data)
        && request.resource.data.id == document
        && hasFlyerPermission('flyer.templates.manage', request.resource.data);

      allow delete: if isAdmin();
    }

    // Asset metadata only. Binary files live in Storage, not Firestore.
    match /flyerAssets/{document} {
      allow read: if hasFlyerPermission('flyer.read', resource.data);

      allow create, update: if activeUser()
        && validFlyerAsset(request.resource.data)
        && request.resource.data.id == document
        && hasFlyerPermission('flyer.assets.manage', request.resource.data);

      allow delete: if isAdmin();
    }

    // Everything else remains closed until its domain rules are implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
