rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public canonical master data.
    // These collections contain only non-personal, already public DNS
    // reference data. Browser clients may read them, but never write them.
    match /reportingAreas/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /destinations/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /organizations/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /organizationRelationships/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /seasons/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Public DNS Design System tokens. Applications may read the current
    // design configuration but browser clients can never modify it.
    match /designSystem/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Private authorization metadata. Each authenticated user may read only
    // their own authorization context. Browser clients can never modify it.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /memberships/{document} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /accessGrants/{document} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Everything else remains closed until its own authentication and
    // authorization model has been explicitly designed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
