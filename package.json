{
  "name": "@dolomitinordicski/dns-shared-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:package": "tsc -p tsconfig.package.json",
    "prepare": "npm run build:package",
    "seed:firebase": "tsx scripts/seed-firestore.ts",
    "seed:firebase:apply": "tsx scripts/seed-firestore.ts --apply",
    "typecheck": "tsc --noEmit",
    "deploy:firebase:rules": "npx firebase-tools@latest deploy --only firestore:rules --project dns-core",
    "seed:design-system": "tsx scripts/seed-design-system.ts",
    "seed:design-system:apply": "tsx scripts/seed-design-system.ts --apply",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:orders:2026-27": "tsx scripts/seed-orders-2026-27.ts",
    "seed:orders:2026-27:apply": "tsx scripts/seed-orders-2026-27.ts --apply",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --only firestore --project demo-dns-core \"node tests/seasonal-rules.test.mjs\"",
    "seed:kp:2026-27": "tsx scripts/seed-kp-2026-27.ts",
    "seed:kp:2026-27:apply": "tsx scripts/seed-kp-2026-27.ts --apply",
    "seed:pocketfolder:2026-27": "tsx scripts/seed-pocketfolder-2026-27.ts",
    "seed:pocketfolder:2026-27:apply": "tsx scripts/seed-pocketfolder-2026-27.ts --apply",
    "seed:area-allocation-keys": "tsx scripts/seed-area-allocation-keys.ts",
    "seed:area-allocation-keys:apply": "tsx scripts/seed-area-allocation-keys.ts --apply",
    "seed:billing-rates:2026-27": "tsx scripts/seed-billing-rates-2026-27.ts",
    "seed:billing-rates:2026-27:apply": "tsx scripts/seed-billing-rates-2026-27.ts --apply",
    "publish:analytics-public": "tsx scripts/publish-analytics-public-snapshot.ts",
    "publish:analytics-public:apply": "tsx scripts/publish-analytics-public-snapshot.ts --apply"
  },
  "devDependencies": {
    "firebase-admin": "^14.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "firebase": "^12.3.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "14.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design-system": {
      "types": "./dist/design-system.d.ts",
      "import": "./dist/design-system.js"
    },
    "./ui/motion": {
      "types": "./dist/ui/motion.d.ts",
      "import": "./dist/ui/motion.js"
    },
    "./ui/interaction": {
      "types": "./dist/ui/interaction.d.ts",
      "import": "./dist/ui/interaction.js"
    },
    "./data-contracts": {
      "types": "./dist/data-contracts.d.ts",
      "import": "./dist/data-contracts.js"
    },
    "./system-status": {
      "types": "./dist/system-status.d.ts",
      "import": "./dist/system-status.js"
    },
    "./ui/accessibility": {
      "types": "./dist/ui/accessibility.d.ts",
      "import": "./dist/ui/accessibility.js"
    },
    "./ui/navigation": {
      "types": "./dist/ui/navigation.d.ts",
      "import": "./dist/ui/navigation.js"
    },
    "./ui/tool-chrome": {
      "types": "./dist/ui/tool-chrome.d.ts",
      "import": "./dist/ui/tool-chrome.js"
    },
    "./ui/print": {
      "types": "./dist/ui/print.d.ts",
      "import": "./dist/ui/print.js"
    },
    "./ui/header-status": {
      "types": "./dist/ui/header-status.d.ts",
      "import": "./dist/ui/header-status.js"
    },
    "./ui/content-patterns": {
      "types": "./dist/ui/content-patterns.d.ts",
      "import": "./dist/ui/content-patterns.js"
    },
    "./ui/primitives": {
      "types": "./dist/ui/primitives.d.ts",
      "import": "./dist/ui/primitives.js"
    },
    "./analytics-public": {
      "types": "./dist/analytics-public.d.ts",
      "import": "./dist/analytics-public.js"
    }
  }
}
