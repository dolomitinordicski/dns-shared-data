{
  "name": "@dolomitinordicski/dns-shared-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed:firebase": "tsx scripts/seed-firestore.ts",
    "seed:firebase:apply": "tsx scripts/seed-firestore.ts --apply",
    "typecheck": "tsc --noEmit",
    "deploy:firebase:rules": "npx firebase-tools@latest deploy --only firestore:rules --project dns-core",
    "seed:design-system": "tsx scripts/seed-design-system.ts",
    "seed:design-system:apply": "tsx scripts/seed-design-system.ts --apply",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:orders:2026-27": "tsx scripts/seed-orders-2026-27.ts",
    "seed:orders:2026-27:apply": "tsx scripts/seed-orders-2026-27.ts --apply",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --only firestore --project demo-dns-core \"node tests/seasonal-rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "firebase": "^12.3.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "14.12.0"
  }
}
